<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="F_DECODE_COMMAND" Id="{0e65f4ec-f4c0-4339-8fe3-300583162c1e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_DECODE_COMMAND : T_COMMAND
VAR_INPUT
	eCommand: E_COMMAND;
	sCommandData:STRING(255);
END_VAR
VAR

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE eCommand OF
