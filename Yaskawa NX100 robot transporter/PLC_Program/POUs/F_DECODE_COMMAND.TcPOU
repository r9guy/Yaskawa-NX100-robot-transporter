		F_DECODE_COMMAND.nData:=0;
	E_COMMAND.MODE:
		F_DECODE_COMMAND.NAME:='MODE';
		F_DECODE_COMMAND.nData:=1;
	E_COMMAND.CYCLE:
		F_DECODE_COMMAND.NAME:='CYCLE';
		F_DECODE_COMMAND.nData:=1;
	E_COMMAND.SVON:
		F_DECODE_COMMAND.NAME:='SVON';
