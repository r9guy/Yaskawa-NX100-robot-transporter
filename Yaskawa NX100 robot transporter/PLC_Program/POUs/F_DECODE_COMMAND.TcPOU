	E_COMMAND.CGROUP:
		F_DECODE_COMMAND.NAME:='CGROUP';
		F_DECODE_COMMAND.nData:=2;
	E_COMMAND.CTASK:
		F_DECODE_COMMAND.NAME:='CTASK';
		F_DECODE_COMMAND.nData:=1;
	E_COMMAND.START:
		F_DECODE_COMMAND.NAME:='START';
		F_DECODE_COMMAND.nData:=0;
	E_COMMAND.START2:
		F_DECODE_COMMAND.NAME:='START';
		F_DECODE_COMMAND.nData:=1;
	E_COMMAND.MOVJ:
